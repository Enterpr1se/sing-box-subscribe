{
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns_proxy",
        "type": "https",
        "server": "dns.controld.com",
        "path": "/fmgnh2zg4y",
        "detour": "PROXY",
        "address_resolver": "dns_resolver"
      },
      {
        "tag": "dns_direct",
        "type": "https",
        "server": "dns.alidns.com",
        "path": "/dns-query",
        "address_resolver": "dns_resolver"
      },
      {
        "tag": "dns_resolver",
        "type": "udp",
        "server": "223.5.5.5"
      },
      {
        "tag": "dns_fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "outbound": "any",
        "server": "dns_direct"
      },
      {
        "clash_mode": "direct",
        "server": "dns_direct"
      },
      {
        "clash_mode": "global",
        "server": "dns_proxy"
      },
      {
        "rule_set": "geosite-cn",
        "server": "dns_direct"
      }
    ],
    "final": "dns_proxy",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30",
        "fd00::1/126"
      ],
      "mtu": 9000,
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed",
      "sniff": true
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080,
      "sniff": true
    }
  ],
  "outbounds": [
    {
      "tag": "PROXY",
      "type": "selector",
      "outbounds": [
        "AUTO",
        "{all}",
        "🇭🇰 香港節點",
        "🇹🇼 台灣節點",
        "🇯🇵 日本節點",
        "🇸🇬 新加坡節點",
        "🇰🇷 韓國節點",
        "🇺🇸 美國節點"
      ]
    },
    {
      "tag": "AUTO",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "exclude",
          "keywords": ["(?i)网站|地址|剩余|过期|时间|提示|Traffic|Expire"]
        }
      ]
    },
    {
      "tag": "🇭🇰 香港節點",
      "type": "urltest",
      "outbounds": [
        "{all}",
        "direct"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": ["(?i)HK|Hong|Kong|香港|港"]
        }
      ]
    },
    {
      "tag": "🇹🇼 台灣節點",
      "type": "urltest",
      "outbounds": [
        "{all}",
        "direct"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": ["(?i)TW|Taiwan|台湾|臺|台"]
        }
      ]
    },
    {
      "tag": "🇯🇵 日本節點",
      "type": "urltest",
      "outbounds": [
        "{all}",
        "direct"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": ["(?i)JP|Japan|日本|日"]
        }
      ]
    },
    {
      "tag": "🇸🇬 新加坡節點",
      "type": "urltest",
      "outbounds": [
        "{all}",
        "direct"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": ["(?i)SG|Singapore|狮城|新加坡|新"]
        }
      ]
    },
    {
      "tag": "🇰🇷 韓國節點",
      "type": "urltest",
      "outbounds": [
        "{all}",
        "direct"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": ["(?i)KR|Korea|KOR|首尔|韩|韓"]
        }
      ]
    },
    {
      "tag": "🇺🇸 美國節點",
      "type": "urltest",
      "outbounds": [
        "{all}",
        "direct"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": ["(?i)US|America|United States|美国|美"]
        }
      ]
    },
    {
      "tag": "GLOBAL",
      "type": "selector",
      "outbounds": [
        "PROXY",
        "direct",
        "block"
      ]
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "block",
      "type": "block"
    }
  ],
  "route": {
    "rules": [
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "clash_mode": "direct",
        "outbound": "direct"
      },
      {
        "clash_mode": "global",
        "outbound": "GLOBAL"
      },
      {
        "rule_set": "geoip-cn",
        "outbound": "direct"
      },
      {
        "rule_set": "geosite-cn",
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs",
        "download_detour": "PROXY"
      },
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs",
        "download_detour": "PROXY"
      }
    ],
    "final": "PROXY",
    "auto_detect_interface": true
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "ui",
      "external_ui_download_url": "https://github.com/MetaCubeX/Yacd-meta/archive/gh-pages.zip",
      "external_ui_download_detour": "PROXY",
      "default_mode": "rule"
    }
  }
}
