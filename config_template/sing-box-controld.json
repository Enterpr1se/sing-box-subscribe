"outbounds": [
  {
    "tag": "🚀 Node Select",
    "type": "selector",
    "default": "⚡ Auto Select",
    "outbounds": [
      "⚡ Auto Select",
      "🖐️ Manual Switch",
      "🌍 All Nodes",
      "AI Services",
      "Streaming",
      "Google Services",
      "Youtube",
      "Telegram",
      "🇭🇰 Hong Kong",
      "🇹🇼 Taiwan",
      "🇯🇵 Japan",
      "🇰🇷 Korea",
      "🇸🇬 Singapore",
      "🇺🇸 United States",
      "direct"
    ]
  },
  {
    "tag": "⚡ Auto Select",
    "type": "urltest",
    "outbounds": ["🌍 All Nodes"],
    "url": "https://www.gstatic.com/generate_204",
    "interval": "600s",
    "tolerance": 50
  },
  {
    "tag": "🖐️ Manual Switch",
    "type": "selector",
    "outbounds": ["🌍 All Nodes"]
  },
  {
    "tag": "🌍 All Nodes",
    "type": "selector",
    "outbounds": ["{all}"],
    "filter": [
      {
        "action": "exclude",
        "keywords": ["最新网址","剩余流量","距离下次重置","套餐到期","网址：","地址：","剩余","到期","流量","重置"]
      }
    ]
  },
  {
    "tag": "🇭🇰 Hong Kong",
    "type": "selector",
    "outbounds": ["{all}"],
    "filter": [
      {
        "action": "include",
        "keywords": ["🇭🇰|HK|hk|香港|港|Hong Kong|HongKong"]
      }
    ]
  },
  {
    "tag": "🇹🇼 Taiwan",
    "type": "selector",
    "outbounds": ["{all}"],
    "filter": [
      {
        "action": "include",
        "keywords": ["🇹🇼|TW|tw|台湾|臺灣|台|Taiwan"]
      }
    ]
  },
  {
    "tag": "🇯🇵 Japan",
    "type": "selector",
    "outbounds": ["{all}"],
    "filter": [
      {
        "action": "include",
        "keywords": ["🇯🇵|JP|jp|日本|日|Japan"]
      }
    ]
  },
  {
    "tag": "🇰🇷 Korea",
    "type": "selector",
    "outbounds": ["{all}"],
    "filter": [
      {
        "action": "include",
        "keywords": ["🇰🇷|KR|kr|韓國|Korea|South Korea|韓"]
      }
    ]
  },
  {
    "tag": "🇸🇬 Singapore",
    "type": "selector",
    "outbounds": ["{all}"],
    "filter": [
      {
        "action": "include",
        "keywords": ["🇸🇬|SG|sg|新加坡|狮城|Singapore"]
      }
    ]
  },
  {
    "tag": "🇺🇸 United States",
    "type": "selector",
    "outbounds": ["{all}"],
    "filter": [
      {
        "action": "include",
        "keywords": ["🇺🇸|US|us|美国|美國|United States|America"]
      }
    ]
  },
  {
    "tag": "AI Services",
    "type": "selector",
    "outbounds": ["🇺🇸 United States", "🇯🇵 Japan", "🇰🇷 Korea"]
  },
  {
    "tag": "Streaming",
    "type": "selector",
    "outbounds": ["🇭🇰 Hong Kong", "🇯🇵 Japan", "🇺🇸 United States"]
  },
  {
    "tag": "Google Services",
    "type": "selector",
    "outbounds": ["🇺🇸 United States", "🇯🇵 Japan"]
  },
  {
    "tag": "Youtube",
    "type": "selector",
    "outbounds": ["🇭🇰 Hong Kong", "🇺🇸 United States"]
  },
  {
    "tag": "Telegram",
    "type": "selector",
    "outbounds": ["🇭🇰 Hong Kong", "🇸🇬 Singapore"]
  },
  {
    "tag": "direct",
    "type": "direct",
    "domain_resolver": {
      "server": "aliDns",
      "rewrite_ttl": 60
    }
  }
]
